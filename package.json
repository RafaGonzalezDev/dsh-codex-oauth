{
  "name": "dsh-chatgpt-plan-workspace",
  "version": "0.1.5-pi-catalog.2",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24 <25"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspace dsh-chatgpt-plan",
    "build:host": "npm run build:host --workspace dsh-chatgpt-plan",
    "build:client": "npm run build:client --workspace dsh-chatgpt-plan",
    "catalog:snapshot": "node --import tsx scripts/update-pi-catalog.ts",
    "typecheck": "tsc -b tsconfig.host.json tsconfig.client.json",
    "test": "node --import tsx --test test/*.test.ts",
    "check": "npm run build && npm test",
    "pack:plugin": "npm pack --workspace dsh-chatgpt-plan --pack-destination ."
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-api-remotes": "0.2.0-rc.2",
    "@deepseek-ai/dsh-app-boot": "0.2.0-rc.2",
    "@deepseek-ai/dsh-attachment": "0.2.0-rc.2",
    "@deepseek-ai/dsh-authorization": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-connection": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-store": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-settings-models": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-sidebar": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.0-rc.2",
    "@deepseek-ai/dsh-credentials": "0.2.0-rc.2",
    "@deepseek-ai/dsh-credentials-local": "0.2.0-rc.2",
    "@deepseek-ai/dsh-fs": "0.2.0-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.0-rc.2",
    "@deepseek-ai/dsh-typert-generator": "0.2.0-rc.2",
    "@deepseek-ai/dsh-typert-protocol": "0.2.0-rc.2",
    "@deepseek-ai/schemastery": "~3.18.4",
    "@types/node": "24.19.0",
    "@types/react": "18.3.31",
    "react": "^18.3.1",
    "semver": "7.8.5",
    "tsdown": "0.23.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
